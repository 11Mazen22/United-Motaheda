{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@pharmacy/design-tokens": ["../design-tokens/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
