{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react-native",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": [],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@app/*": [
        "./app/*"
      ],
      "react-native": ["./node_modules/react-native"],
      "react-native-reanimated": ["./node_modules/react-native-reanimated"],
      "react-native-safe-area-context": ["./node_modules/react-native-safe-area-context"],
      "@expo/vector-icons": ["./node_modules/@expo/vector-icons"],
      "expo-haptics": ["./node_modules/expo-haptics"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.d.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "home-snapshot",
    "home-screen-replacement.tsx",
    "supabase/functions/**"
  ]
}
