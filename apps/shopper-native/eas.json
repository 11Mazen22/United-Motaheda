{
  "cli": {
    "version": ">= 18.13.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "20.19.4"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "CMAKE_VERSION": "3.22.1"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "env": {
        "CMAKE_VERSION": "3.22.1"
      }
    },
    "production-apk": {
      "extends": "base",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "channel": "production-apk",
      "env": {
        "CMAKE_VERSION": "3.22.1"
      }
    },
    "verify": {
      "extends": "base",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "channel": "verify",
      "env": {
        "CMAKE_VERSION": "3.22.1"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "credentialsSource": "local",
      "channel": "production",
      "env": {
        "CMAKE_VERSION": "3.22.1"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "production"
      }
    }
  }
}
